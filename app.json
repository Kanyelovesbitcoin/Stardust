{
  "expo": {
    "name": "Stardust",
    "slug": "lucid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0A14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stardust.app",
      "buildNumber": "9",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0A14"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 9,
      "package": "com.stardust.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "stardust",
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "infoPlist": {
              "ITSAppUsesNonExemptEncryption": false
            }
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C4A265"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eba03bfe-c8fc-4695-8924-84a955abf103"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eba03bfe-c8fc-4695-8924-84a955abf103"
    },
    "owner": "lordluke29"
  }
}
