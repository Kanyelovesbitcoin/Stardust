{
  "expo": {
    "name": "Droplett",
    "slug": "lucid",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/droplet-icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0EBE0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stardust.app",
      "buildNumber": "33",
      "entitlements": {
        "com.apple.developer.applesignin": ["Default"],
        "com.apple.developer.associated-domains": []
      },
      "infoPlist": {
        "CFBundleDisplayName": "Droplett",
        "NSMicrophoneUsageDescription": "Droplett needs microphone access so you can voice-record a dream journal entry. For example, tap the record button on the Record screen, speak your dream aloud, and Droplett will transcribe your spoken words into a private written journal entry. Audio is processed only while the app is open and is never shared with third parties.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/droplet-icon.png",
        "backgroundColor": "#F0EBE0"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 33,
      "package": "com.stardust.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "droplett",
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "infoPlist": {
              "ITSAppUsesNonExemptEncryption": false
            }
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/droplet-icon.png",
          "color": "#C4A265"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eba03bfe-c8fc-4695-8924-84a955abf103"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eba03bfe-c8fc-4695-8924-84a955abf103"
    },
    "owner": "lordluke29"
  }
}
